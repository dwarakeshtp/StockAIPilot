# LLM provider used for agent narratives and the Critic explanation.
# One of: openrouter | cohere | none   (none = deterministic template explanations)
LLM_PROVIDER=none

# OpenRouter (https://openrouter.ai) - free models end with ":free" and must support chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cohere (https://dashboard.cohere.com) - trial keys are free.
# Called through Cohere's OpenAI-compatible endpoint.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Optional: also try the other provider when the primary fails.
LLM_ENABLE_FALLBACK=true
